// C:\DataFlex Projects\FutbolWebApp\AppSrc\JugadorView.wo
// JugadorView
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd

Object oJugadorView is a cWebView
    Set piColumnCount to 12
    Set psCaption to "JugadorView"
    Set piWidth to 700

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server To oliga_DD
    End_Object 

    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server To oequipo_DD
    End_Object 

    Set Main_DD To ojugador_DD
    Set Server  To ojugador_DD


    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object ojugadorID is a cWebForm
            Entry_Item jugador.ID
            Set piColumnSpan to 2
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "ID"
        End_Object 

        Object ojugadorNombre is a cWebForm
            Entry_Item jugador.Nombre
            Set piColumnSpan to 11
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nombre"
        End_Object 

        Object ojugadorApellido is a cWebForm
            Entry_Item jugador.Apellido
            Set piColumnSpan to 11
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Apellido"
        End_Object 

        Object ojugadorNacionalidad is a cWebForm
            Entry_Item jugador.Nacionalidad
            Set piColumnSpan to 9
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nacionalidad"
        End_Object 

        Object oequipoID is a cWebForm
            Entry_Item equipo.ID
            Set piColumnSpan to 2
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "EquipoID"
        End_Object 
        
        Object oJugador_View is a cWebView
    Object oPosicion_DD is a Posicion_DataDictionary
    End_Object

    Object oJugador_DD is a Jugador_DataDictionary
        Set Server to oPosicion_DD
    End_Object

    Set Main_DD to oJugador_DD
    Set Server to oJugador_DD

   
    Object oJugadorPosicion is a cWebForm
        Entry_Item Posicion.Nombre
        Set psCaption to "Posición de Juego:"
        Set pbReadOnly to True 
    End_Object

 
    Object oBtnBuscarPosicion is a cWebButton
        Set psCaption to "Buscar Posición..."
        
        Procedure OnClick
          
            Send NavigateForward of oSelectPosiciones Self
        End_Procedure

       
        Procedure OnGetNavigateForwardData tWebNavigateData ByRef ltNavigateData
            Move ntNavigateForward to ltNavigateData.eNavigateType [cite: 26]
       
            Move False to ltNavigateData.bNewRecord [cite: 30]
        End_Procedure

  
        Procedure OnNavigateBack tWebNavigateData ltNavigateData
       
            If (ltNavigateData.sRowID <> "") Begin [cite: 29]
                Send FindByRowId of oPosicion_DD Posicion.File_Number (DeserializeRowID(ltNavigateData.sRowID))
            End
        End_Procedure
    End_Object
End_Object
    End_Object 

End_Object 
